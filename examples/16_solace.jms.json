{
  "version": "v1.0",

  "listeners": [
    {
      "type": { "name": "Listener" },
      "services": ["$service"],
      "multipleServicesAllowed": true,
      "multipleServicesOfSameTypeAllowed": true
    }
  ],

  "serviceTypes": [
    {
      "id": "$service",
      "type": { "name": "Service" },
      "concrete": false,
      "multipleListenersAllowed": true,
      "annotations": ["$serviceConfig"],
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "name": "onMessage",
            "kind": "remote",
            "doc": "Invoked once per message delivered from the queue or topic named in @jms:ServiceConfig. Declare a narrower payload type to project the message payload, see the messagePayload data-binding rule.",
            "presence": "required",
            "params": [
              {
                "name": "message",
                "doc": "The delivered message. Declare a narrower type to project the payload, see the messagePayload data-binding rule.",
                "type": { "name": "Message" },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": { "name": "anydata" },
                      "shapes": [{ "form": "included", "envelope": { "name": "Message" }, "bindableFields": ["payload"] }]
                    }
                  ]
                }
              },
              {
                "name": "caller",
                "doc": "Handle for explicit acknowledgement and transaction control. Needed only when the service's ackMode is CLIENT_ACKNOWLEDGE (for caller->ack) or SESSION_TRANSACTED (for caller->commit/caller->rollback).",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": [{ "name": "Error" }, { "name": "()" }]
          },
          {
            "name": "onError",
            "kind": "remote",
            "doc": "Invoked when a delivered message cannot be dispatched to onMessage, most commonly because its payload fails to bind to a declared narrowed payload type.",
            "presence": "optional",
            "params": [
              {
                "name": "err",
                "doc": "The failure that prevented dispatch.",
                "type": { "name": "Error" },
                "presence": "required"
              }
            ],
            "returns": [{ "name": "Error" }, { "name": "()" }]
          }
        ]
      }
    }
  ],

  "annotations": [
    { "id": "$serviceConfig", "type": { "name": "ServiceConfiguration" }, "attachPoint": "service", "presence": "required" }
  ]
}
