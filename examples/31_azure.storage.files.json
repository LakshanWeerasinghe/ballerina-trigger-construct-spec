{
  "version": "v1.0",

  "listeners": [
    { "type": { "name": "Listener" }, "services": ["$service"], "multipleServicesAllowed": false }
  ],

  "serviceTypes": [
    {
      "id": "$service",
      "type": { "name": "Service" },
      "concrete": false,
      "multipleListenersAllowed": true,
      "annotations": ["$serviceConfig"],
      "identifier": { "presence": "optional", "form": ["basePath"] },
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "name": "onFileText",
            "kind": "remote",
            "doc": "Invoked for each file whose name ends in .txt, or that matches the pattern set on @files:FunctionConfig. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              { "name": "content", "doc": "The file's text content, decoded as UTF-8.", "type": { "name": "string" }, "presence": "required" },
              {
                "name": "fileInfo",
                "doc": "The file's share name, path, size, ETag, and last-modified time.",
                "type": { "name": "FileInfo" },
                "presence": "optional"
              },
              {
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onFileJson",
            "kind": "remote",
            "doc": "Invoked for each file whose name ends in .json, or that matches the pattern set on @files:FunctionConfig. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "content",
                "doc": "The parsed content, bind a record type to project it. Binding is strict: the content must match the target type exactly.",
                "type": { "name": "json" },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    { "constraint": { "name": "json" }, "shapes": [{ "form": "bare" }] },
                    { "constraint": { "name": "record {}" }, "shapes": [{ "form": "bare" }] }
                  ]
                }
              },
              {
                "name": "fileInfo",
                "doc": "The file's share name, path, size, ETag, and last-modified time.",
                "type": { "name": "FileInfo" },
                "presence": "optional"
              },
              {
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onFileXml",
            "kind": "remote",
            "doc": "Invoked for each file whose name ends in .xml, or that matches the pattern set on @files:FunctionConfig. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "content",
                "doc": "The parsed content, bind a record type to project it from the document. Binding is strict.",
                "type": { "name": "xml" },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    { "constraint": { "name": "xml" }, "shapes": [{ "form": "bare" }] },
                    { "constraint": { "name": "record {}" }, "shapes": [{ "form": "bare" }] }
                  ]
                }
              },
              {
                "name": "fileInfo",
                "doc": "The file's share name, path, size, ETag, and last-modified time.",
                "type": { "name": "FileInfo" },
                "presence": "optional"
              },
              {
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onFileCsv",
            "kind": "remote",
            "doc": "Invoked for each file whose name ends in .csv, or that matches the pattern set on @files:FunctionConfig. Declaring a stream parameter reads the file in chunks instead of loading it into memory. Falls through to onFile when not declared.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "content",
                "doc": "The parsed rows, as batched or streamed string rows or records; the field names of a record row come from the header row. Binding is strict.",
                "type": [
                  { "shape": "array", "elementType": { "shape": "array", "elementType": { "name": "string" } } },
                  { "shape": "array", "elementType": { "name": "record {}" } },
                  {
                    "shape": "stream",
                    "elementType": { "shape": "array", "elementType": { "name": "string" } },
                    "completionType": [{ "name": "error" }, { "name": "()" }]
                  },
                  {
                    "shape": "stream",
                    "elementType": { "name": "record {}" },
                    "completionType": [{ "name": "error" }, { "name": "()" }]
                  }
                ],
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": { "shape": "array", "elementType": { "name": "string" } },
                      "shapes": [
                        { "form": "array", "element": "bare" },
                        { "form": "stream", "element": "bare", "completionType": [{ "name": "error" }, { "name": "()" }] }
                      ]
                    },
                    {
                      "constraint": { "name": "record {}" },
                      "shapes": [
                        { "form": "array", "element": "bare" },
                        { "form": "stream", "element": "bare", "completionType": [{ "name": "error" }, { "name": "()" }] }
                      ]
                    }
                  ]
                }
              },
              {
                "name": "fileInfo",
                "doc": "The file's share name, path, size, ETag, and last-modified time.",
                "type": { "name": "FileInfo" },
                "presence": "optional"
              },
              {
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onFile",
            "kind": "remote",
            "doc": "Invoked for any file no typed handler matched, and as the fallback when no typed handler is declared. Content arrives as raw bytes.",
            "presence": "optional",
            "annotations": ["$functionConfig"],
            "params": [
              {
                "name": "content",
                "doc": "The file's bytes. Declare the stream form to read large files in chunks rather than loading them into memory.",
                "type": [
                  { "shape": "array", "elementType": { "name": "byte" } },
                  {
                    "shape": "stream",
                    "elementType": { "shape": "array", "elementType": { "name": "byte" } },
                    "completionType": [{ "name": "error" }, { "name": "()" }]
                  }
                ],
                "presence": "required"
              },
              {
                "name": "fileInfo",
                "doc": "The file's share name, path, size, ETag, and last-modified time.",
                "type": { "name": "FileInfo" },
                "presence": "optional"
              },
              {
                "name": "caller",
                "doc": "The share connection, for reading or writing other files while this one is being processed.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          },
          {
            "name": "onError",
            "kind": "remote",
            "doc": "Invoked when a poll, download, or content-binding failure occurs. Without it, the failure is logged and polling continues.",
            "presence": "optional",
            "params": [
              {
                "name": "err",
                "doc": "The failure that interrupted processing.",
                "type": { "name": "Error" },
                "presence": "required"
              },
              {
                "name": "caller",
                "doc": "The share connection, for acting on the share while handling the failure.",
                "type": { "name": "Caller" },
                "presence": "optional"
              }
            ],
            "returns": [{ "name": "error" }, { "name": "()" }]
          }
        ]
      },
      "rules": [
        {
          "id": "$atLeastOneFileHandler",
          "rule": "structure.atLeastOne",
          "message": "An Azure Files service must declare at least one file handler. onError alone never receives a file, so the service would do nothing.",
          "subjects": [
            { "kind": "handler", "name": "onFileText" },
            { "kind": "handler", "name": "onFileJson" },
            { "kind": "handler", "name": "onFileXml" },
            { "kind": "handler", "name": "onFileCsv" },
            { "kind": "handler", "name": "onFile" }
          ]
        }
      ]
    }
  ],

  "annotations": [
    { "id": "$serviceConfig", "type": { "name": "ServiceConfiguration" }, "attachPoint": "service", "presence": "optional" },
    { "id": "$functionConfig", "type": { "name": "FunctionConfiguration" }, "attachPoint": "function", "presence": "optional" }
  ]
}
